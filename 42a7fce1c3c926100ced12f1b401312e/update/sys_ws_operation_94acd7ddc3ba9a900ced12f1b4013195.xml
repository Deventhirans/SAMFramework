        <name>complete_stage</name>
        <operation_script><![CDATA[(function process(request, response) {
    var stageId = request.queryParams.stage_id; // Get the stage ID from the query parameter
    var helper = new StageProgressHelper(); // Use the Script Include created earlier
    var percentage = helper.markStageCompleted(stageId); // Mark the stage and get the completion percentage
    
    // Respond with a success status and the updated percentage
    response.setBody({
        success: true,
        message: "Stage marked as completed successfully.",
        percentage: percentage
    });
})(request, response);
]]></operation_script>
