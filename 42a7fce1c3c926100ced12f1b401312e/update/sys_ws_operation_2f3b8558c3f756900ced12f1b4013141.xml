        <http_method>GET</http_method>
        <name>GetKPIs</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {
    var property = gs.getProperty('kpi.dashboard.data');
    if (!property) {
        response.setStatus(404);
        response.setBody({ error: "KPI data not found" });
        return;
    }
    
    try {
        var kpiData = JSON.parse(property);
        response.setStatus(200);
        response.setBody(kpiData);
    } catch (e) {
        response.setStatus(500);
        response.setBody({ error: "Failed to parse KPI data", details: e.message });
    }
})(request, response);
]]></operation_script>
