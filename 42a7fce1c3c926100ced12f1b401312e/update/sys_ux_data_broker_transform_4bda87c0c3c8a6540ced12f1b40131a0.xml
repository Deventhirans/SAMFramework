        <script><![CDATA[function transform(input) {
    var roles = [];

    var gr = new GlideRecord('sys_user_role');
    gr.addEncodedQuery('nameISNOTEMPTY'); // Ensures only valid CIs are retrieved
    gr.query();

    while (gr.next()) {
        roles.push({
            "id": gr.getUniqueValue(),
            "label": gr.getValue('sys_name'),
            "sublabel": gr.getValue('name') // Using CI class as sublabel
           
        });
    }

    return roles;
}
]]></script>
